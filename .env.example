# ==============================================================================
# Environment Variables Example
# ==============================================================================
# Note: Never commit sensitive credentials to version control.
# Copy this file to .env.local for local development.

# Database (PostgreSQL with PostGIS extension)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/elysia_db"

# Better Auth Configuration
# Generate a secret via: openssl rand -base64 32
BETTER_AUTH_SECRET="your-32-character-secret-key-here-min-length"
BETTER_AUTH_URL="http://localhost:3000"

# Public App URL for client-side API requests
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Runtime Environment
NODE_ENV="development"

# Optional CORS Allowed Origins (comma separated)
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Google OAuth 2.0 Credentials (Optional / for Google Sign-In)
# Callback URL di Google Cloud Console: <BETTER_AUTH_URL>/api/auth/callback/google
# (Contoh: http://localhost:3000/api/auth/callback/google atau https://domain-anda.com/api/auth/callback/google)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Default password for seeded test/official accounts (min 12 characters)
SEED_DEFAULT_PASSWORD="wiskaprayoga12"

CLOUDINARY_CLOUD_NAME="surabiedev"
CLOUDINARY_API_KEY="381297835674653"
CLOUDINARY_API_SECRET="PDbJPxGUNPhgtkB46dHE6b4BGMs"