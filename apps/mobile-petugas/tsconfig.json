{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@cater/types": ["../../packages/types/src"],
      "@cater/ui-mobile": ["../../packages/ui-mobile/src"],
      "@cater/api-client": ["../../packages/api-client/src"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "../../packages/ui-mobile/nativewind-env.d.ts"
  ]
}
