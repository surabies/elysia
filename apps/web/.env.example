# ==============================================================================
# Environment Variables Example
# ==============================================================================
# Note: Never commit sensitive credentials to version control.
# Copy this file to .env.local for local development.

# Database (PostgreSQL with PostGIS extension)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/elysia_db"

# Better Auth Configuration
# Generate a secret via: openssl rand -base64 32
BETTER_AUTH_SECRET="your-32-character-secret-key-here-min-length"
BETTER_AUTH_URL="http://localhost:3000"

# Public App URL for client-side API requests
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Runtime Environment
NODE_ENV="development"

CLOUDINARY_CLOUD_NAME="surabiedev"
CLOUDINARY_API_KEY="381297835674653"
CLOUDINARY_API_SECRET="PDbJPxGUNPhgtkB46dHE6b4BGMs"

# Optional CORS Allowed Origins (comma separated)
CORS_ALLOWED_ORIGINS="http://localhost:3000"
