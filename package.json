{
  "name": "cater-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app src components packages",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "bun --cwd packages/db db:generate",
    "db:migrate": "bun --cwd packages/db db:migrate",
    "db:studio": "bun --cwd packages/db db:studio",
    "db:seed": "bun --cwd packages/db db:seed",
    "auth:generate": "bun x @better-auth/cli generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@cater/db": "workspace:*",
    "@cater/types": "workspace:*",
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/eden": "^1.4.9",
    "@geist-ui/icons": "^1.0.2",
    "@hookform/resolvers": "^7.0.3",
    "@shadcn/react": "^0.3.1",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.31",
    "embla-carousel-react": "^8.6.0",
    "geist": "^1.9.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.69.0",
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "postgres": "^4.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4",
    "recharts": "3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.72.1"
  }
}
