{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": false,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["../../apps/web/src/*"],
      "@cater/types": ["../../packages/types/src"],
      "@cater/db": ["../../packages/db/src"],
      "@cater/backend": ["../../packages/backend/src"],
      "@cater/backend/*": ["../../packages/backend/src/*"],
      "@/server/services/cater/*": ["../../packages/backend/src/services/pencatat-meter/cater/*"],
      "@/server/services/import/*": ["../../packages/backend/src/services/pencatat-meter/import/*"],
      "@/server/services/laporan/*": ["../../packages/backend/src/services/pencatat-meter/laporan/*"],
      "@/server/services/rute/*": ["../../packages/backend/src/services/pencatat-meter/rute/*"],
      "@/server/services/closing/*": ["../../packages/backend/src/services/penagihan/closing/*"],
      "@/server/services/mandiri/*": ["../../packages/backend/src/services/langganan/mandiri/*"],
      "@/server/services/pengaduan/*": ["../../packages/backend/src/services/langganan/pengaduan/*"],
      "@/server/services/master/*": ["../../packages/backend/src/services/langganan/master/*"],
      "@/server/services/pelanggan/*": ["../../packages/backend/src/services/langganan/pelanggan/*"],
      "@/server/services/publik/*": ["../../packages/backend/src/services/langganan/publik/*"],
      "@/server/services/pengaturan/*": ["../../packages/backend/src/services/langganan/pengaturan/*"],
      "@/server/services/kpi/*": ["../../packages/backend/src/services/sdm/kpi/*"],
      "@/server/services/geo/*": ["../../packages/backend/src/services/sub-zona/geo/*"],
      "@/server/services/gwm/*": ["../../packages/backend/src/services/rpm/gwm/*"],
      "@/server/services/dashboard/*": ["../../packages/backend/src/services/core/dashboard/*"],
      "@/server/services/mock/*": ["../../packages/backend/src/services/core/mock/*"],
      "@/server/services/broadcast/*": ["../../packages/backend/src/services/core/broadcast/*"],
      "@/server/*": ["../../packages/backend/src/*"]
    }
  },
  "include": ["src/**/*"]
}
